AISP_STORAGE_BACKEND=local

# Optional S3-compatible storage configuration.
# Set AISP_STORAGE_BACKEND=s3 to enable it.
# AISP_S3_BUCKET=aisp
# AISP_S3_ENDPOINT=https://<region>.digitaloceanspaces.com
# AISP_S3_REGION=<region>
# AISP_S3_ACCESS_KEY_ID=<access-key-id>
# AISP_S3_SECRET_ACCESS_KEY=<secret-access-key>
# AISP_S3_PREFIX=<optional-prefix>
