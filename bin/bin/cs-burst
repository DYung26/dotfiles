#!/usr/bin/env bash
set -Eeuo pipefail
DEFAULT_REPO="${CS_BURST_REPO:-DYung26/codespaces-burst}"
DEFAULT_MACHINE="${CS_BURST_MACHINE:-standardLinux32gb}"
DEFAULT_IDLE="${CS_BURST_IDLE_TIMEOUT:-5m}"
DEFAULT_RETENTION="${CS_BURST_RETENTION:-24h}"
TMP_BASE="${TMPDIR:-/tmp}"
die(){ printf 'cs-burst: %s\n' "$*" >&2; exit 2; }
note(){ printf 'cs-burst: %s\n' "$*" >&2; }
usage(){ cat <<'EOF'
Usage:
  cs-burst run --repo OWNER/REPO [--account gh-26|gh-06|gh-df|gh-odo|gh-do] [--workdir PATH] [--machine NAME] -- COMMAND [ARG...]
  cs-burst exec --codespace NAME [--output FILE] [--account ALIAS] -- COMMAND [ARG...]
  cs-burst cp --codespace NAME [--account ALIAS] [--recursive] SOURCE DESTINATION
  cs-burst stop --codespace NAME [--account ALIAS]
  cs-burst delete --codespace NAME [--account ALIAS]
  cs-burst status [--account ALIAS]
  cs-burst tunnel connect|expose|status|disconnect [OPTIONS]
  cs-burst accounts

Creates a disposable Codespace from a minimal launcher, transfers a sanitized
snapshot of the local worktree (--workdir, default: current directory), runs the
command in /workspaces/<repo>, collects logs/artifacts, and deletes the worker.
--repo is the GitHub project identity used for access validation and workspace
naming; it does not fetch source from GitHub. Uncommitted and untracked local
source changes are included. The VPS checkout remains authoritative.

Options: --repo OWNER/REPO (required), --account ALIAS, --launcher OWNER/REPO,
--machine NAME, --idle-timeout DURATION, --retention DURATION, --workdir PATH,
--include PATH (repeatable; explicitly adds an excluded path),
--allow-sensitive-snapshot (required for env/credential/key paths),
--keep (stop but retain the Codespace for debugging),
--keep-running (leave the Codespace running for a temporary test environment),
--no-artifacts, --dry-run.

Snapshot defaults exclude credentials, dependency directories, generated output,
artifacts and editor metadata. --include adds exact paths from --workdir, including
otherwise-excluded paths; .git metadata is never included. Sensitive paths require
--allow-sensitive-snapshot; contents are transferred to the Codespace and are
visible to the remote command.

Use exec/cp/stop/delete to inspect and manage an existing Codespace. Use tunnel
connect/expose/status/disconnect to bridge two Codespaces through this host and
optionally publish both host loopback forwards to the tailnet.
--keep-running is for temporary test environments only; Codespaces remain subject
to idle timeout and the 12-hour maximum lifetime.
EOF
}
set_account(){ case "${1:-}" in gh-26|gh-06|gh-df|gh-odo|gh-do) export CS_BURST_ACCOUNT="$1";; *) die "unknown account alias '$1'";; esac; }
ghx(){ case "${CS_BURST_ACCOUNT:-}" in
  '') command gh "$@";;
  gh-26) GH_CONFIG_DIR="$HOME/.config/gh" command gh "$@";;
  gh-06) GH_CONFIG_DIR="$HOME/.config/gh-dyung06" command gh "$@";;
  gh-df) GH_CONFIG_DIR="$HOME/.config/gh-dyungfirm" command gh "$@";;
  gh-odo) GH_CONFIG_DIR="$HOME/.config/gh-oyedanolu" command gh "$@";;
  gh-do) GH_CONFIG_DIR="$HOME/.config/gh-danieloyekunle" command gh "$@";; *) die 'invalid account';; esac; }
tunnel_usage(){ cat <<'EOF'
Usage:
  cs-burst tunnel connect --backend-codespace NAME --frontend-codespace NAME [--name PROFILE]
  cs-burst tunnel expose [--name PROFILE] [--frontend-https-port PORT] [--backend-https-port PORT]
  cs-burst tunnel status [--name PROFILE]
  cs-burst tunnel disconnect [--name PROFILE]
Defaults: remote ports backend=5550/frontend=5000; host loopback ports backend=15550/frontend=15000; HTTPS ports frontend=10443/backend=11443.
EOF
}
tunnel_root(){ if [[ -n "${XDG_STATE_HOME:-}" ]]; then printf '%s/cs-burst/tunnels' "$XDG_STATE_HOME"; else printf '%s/.local/state/cs-burst/tunnels' "$HOME"; fi; }
tunnel_free(){ ! ss -H -ltn "sport = :$1" 2>/dev/null | grep -q .; }
tunnel_alive(){ [[ -n "$1" ]] && kill -0 "$1" 2>/dev/null; }
tunnel_pid_owned(){
  local p="$1" config="$2" stat args
  tunnel_alive "$p" || return 1
  stat="$(ps -p "$p" -o stat= 2>/dev/null || true)"
  [[ -n "$stat" && "$stat" != Z* ]] || return 1
  args="$(ps -p "$p" -o args= 2>/dev/null || true)"
  [[ "$args" == *"ssh -F $config -N"* ]]
}
tunnel_load(){ [[ -f "$1/state.env" ]] || die "unknown tunnel profile: $1"; source "$1/state.env"; }
tunnel_key(){
  local key
  for key in "$HOME"/.ssh/id_ed25519 "$HOME"/.ssh/id_rsa "$HOME"/.ssh/id_ecdsa; do
    if [[ -f "$key" ]] && ssh-keygen -y -P '' -f "$key" >/dev/null 2>&1; then printf '%s' "$key"; return; fi
  done
  die 'no usable SSH private key found in the home SSH directory'
}
tunnel_ghdir(){
  case "${CS_BURST_ACCOUNT:-}" in
    ''|gh-26) printf '%s' "$HOME/.config/gh";;
    gh-06) printf '%s' "$HOME/.config/gh-dyung06";;
    gh-df) printf '%s' "$HOME/.config/gh-dyungfirm";;
    gh-odo) printf '%s' "$HOME/.config/gh-oyedanolu";;
    gh-do) printf '%s' "$HOME/.config/gh-danieloyekunle";;
    *) die 'invalid GitHub account profile';;
  esac
}
tunnel_alias(){ awk -v n="$2" '/^Host /{h=$2} /ProxyCommand/ && index($0,n){print h;exit}' "$1"; }
tunnel_spawn(){ local log="$1" pid="$2"; shift 2; nohup "$@" >"$log" 2>&1 </dev/null & echo "$!" >"$pid"; }
tunnel_connect(){
  local profile=vazzel backend= frontend= bp=5550 fp=5000 bhp=15550 fhp=15000
  local state key cfg ba fa ghdir ready=0 opt
  while (($#)); do
    opt="$1"; shift
    case "$opt" in
      --name) profile="$1"; shift;;
      --backend-codespace) backend="$1"; shift;;
      --frontend-codespace) frontend="$1"; shift;;
      --backend-port) bp="$1"; shift;;
      --frontend-port) fp="$1"; shift;;
      --backend-host-port) bhp="$1"; shift;;
      --frontend-host-port) fhp="$1"; shift;;
      --account) set_account "$1"; shift;;
      *) die "unknown tunnel connect option: $opt";;
    esac
  done
  [[ "$profile" =~ ^[A-Za-z0-9_.-]+$ && -n "$backend" && -n "$frontend" && "$backend" != "$frontend" ]] || die 'connect requires a valid profile and distinct Codespace names'
  for p in "$bp" "$fp" "$bhp" "$fhp"; do [[ "$p" =~ ^[0-9]+$ ]] && ((p>0 && p<65536)) || die "invalid port: $p"; done
  state="$(tunnel_root)/$profile"; [[ ! -e "$state" ]] || die 'profile exists; inspect or disconnect it first'
  ghx auth status >/dev/null 2>&1 || die 'GitHub CLI profile is not authenticated'
  key="$(tunnel_key)"
  note "validating backend Codespace $backend"
  ghx codespace ssh -c "$backend" -- -i "$key" true || die 'backend SSH validation failed'
  note "validating frontend Codespace $frontend"
  ghx codespace ssh -c "$frontend" -- -i "$key" true || die 'frontend SSH validation failed'
  tunnel_free "$bhp" && tunnel_free "$fhp" || die 'one or both host ports are occupied'
  mkdir -p "$state"; cfg="$state/ssh_config"
  ghx codespace ssh --config >"$cfg" 2>"$state/ssh-config.stderr" || true; chmod 600 "$cfg"
  sed -i "s#${HOME}/.ssh/codespaces.auto#$key#g" "$cfg"
  ghdir="$(tunnel_ghdir)"
  if [[ "$ghdir" != "$HOME/.config/gh" ]]; then sed -i "s#/usr/bin/gh#env GH_CONFIG_DIR=$ghdir /usr/bin/gh#g" "$cfg"; fi
  ba="$(tunnel_alias "$cfg" "$backend")"; fa="$(tunnel_alias "$cfg" "$frontend")"
  [[ -n "$ba" && -n "$fa" ]] || die 'could not resolve SSH aliases from generated config'
  ssh -F "$cfg" -G "$ba" >/dev/null; ssh -F "$cfg" -G "$fa" >/dev/null
  tunnel_spawn "$state/backend.log" "$state/backend.pid" ssh -F "$cfg" -N -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -L "127.0.0.1:$bhp:127.0.0.1:$bp" "$ba"
  tunnel_spawn "$state/frontend.log" "$state/frontend.pid" ssh -F "$cfg" -N -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -L "127.0.0.1:$fhp:127.0.0.1:$fp" -R "127.0.0.1:$bhp:127.0.0.1:$bhp" "$fa"
  for i in {1..30}; do
    if tunnel_alive "$(cat "$state/backend.pid")" && tunnel_alive "$(cat "$state/frontend.pid")" && ! tunnel_free "$bhp" && ! tunnel_free "$fhp"; then ready=1; break; fi
    sleep 1
  done
  if ((ready==0)); then kill "$(cat "$state/backend.pid")" "$(cat "$state/frontend.pid")" 2>/dev/null || true; tail -30 "$state"/*.log 2>/dev/null || true; die "SSH forwards failed to start; diagnostic files retained in $state"; fi
  cat >"$state/state.env" <<EOF
PROFILE='$profile'
BACKEND_CODESPACE='$backend'
FRONTEND_CODESPACE='$frontend'
BACKEND_PORT='$bp'
FRONTEND_PORT='$fp'
BACKEND_HOST_PORT='$bhp'
FRONTEND_HOST_PORT='$fhp'
FRONTEND_HTTPS_PORT=''
BACKEND_HTTPS_PORT=''
TAILSCALE_FQDN=''
EOF
  note "backend $backend:$bp -> 127.0.0.1:$bhp"
  note "frontend $frontend:$fp -> 127.0.0.1:$fhp"
  note "frontend reverse bridge 127.0.0.1:$bhp -> backend via this host"
  note "state/logs: $state"
}
tunnel_expose(){
  local profile=vazzel state fh=10443 bh=11443 fqdn status opt
  while (($#)); do opt="$1"; shift; case "$opt" in
    --name) profile="$1"; shift;;
    --frontend-https-port) fh="$1"; shift;;
    --backend-https-port) bh="$1"; shift;;
    --account) set_account "$1"; shift;;
    *) die "unknown tunnel expose option: $opt";;
  esac; done
  [[ "$fh" =~ ^[0-9]+$ && "$bh" =~ ^[0-9]+$ ]] && ((fh>0 && fh<65536 && bh>0 && bh<65536 && fh!=bh)) || die 'invalid HTTPS ports'
  state="$(tunnel_root)/$profile"; tunnel_load "$state"
  tunnel_alive "$(cat "$state/backend.pid")" && tunnel_alive "$(cat "$state/frontend.pid")" || die 'SSH tunnels are not both running'
  command -v tailscale >/dev/null && command -v jq >/dev/null || die 'tailscale and jq are required'
  fqdn="$(tailscale status --json | jq -r '.Self.DNSName // empty' | sed 's/\.$//')"; [[ -n "$fqdn" ]] || die 'could not read Tailscale MagicDNS name'
  status="$(tailscale serve status 2>&1 || true)"
  grep -Eq ":$fh( |/|$)|:$bh( |/|$)" <<<"$status" && die 'one requested Tailscale Serve port is already configured'
  tailscale serve --bg --https="$fh" "http://127.0.0.1:$FRONTEND_HOST_PORT"
  if ! tailscale serve --bg --https="$bh" "http://127.0.0.1:$BACKEND_HOST_PORT"; then tailscale serve --https="$fh" off >/dev/null 2>&1 || true; die 'backend Serve failed; frontend handler rolled back'; fi
  cat >>"$state/state.env" <<EOF
FRONTEND_HTTPS_PORT='$fh'
BACKEND_HTTPS_PORT='$bh'
TAILSCALE_FQDN='$fqdn'
EOF
  note "frontend: https://$fqdn:$fh/"
  note "backend admin: https://$fqdn:$bh/admin/"
  note "backend API: https://$fqdn:$bh/"
  note 'Tailscale Serve is tailnet-only.'
}
tunnel_status(){
  local profile=vazzel state p label opt
  while (($#)); do opt="$1"; shift; case "$opt" in --name) profile="$1"; shift;; --account) set_account "$1"; shift;; *) die "unknown tunnel status option: $opt";; esac; done
  state="$(tunnel_root)/$profile"; tunnel_load "$state"
  printf 'Profile: %s\nBackend: %s:%s -> 127.0.0.1:%s\nFrontend: %s:%s -> 127.0.0.1:%s\n' "$PROFILE" "$BACKEND_CODESPACE" "$BACKEND_PORT" "$BACKEND_HOST_PORT" "$FRONTEND_CODESPACE" "$FRONTEND_PORT" "$FRONTEND_HOST_PORT"
  for label in backend frontend; do p="$(cat "$state/$label.pid")"; if tunnel_pid_owned "$p" "$state/ssh_config"; then echo "$label SSH session: running (pid $p)"; else echo "$label SSH session: STOPPED (pid $p)"; fi; done
  ss -ltn | grep -E ":($BACKEND_HOST_PORT|$FRONTEND_HOST_PORT)\b" || true
  tailscale serve status 2>/dev/null || true
  if [[ -n "$TAILSCALE_FQDN" ]]; then echo "Frontend URL: https://$TAILSCALE_FQDN:$FRONTEND_HTTPS_PORT/"; echo "Backend admin URL: https://$TAILSCALE_FQDN:$BACKEND_HTTPS_PORT/admin/"; fi
}
tunnel_disconnect(){
  local profile=vazzel state p label status opt
  while (($#)); do opt="$1"; shift; case "$opt" in --name) profile="$1"; shift;; --account) set_account "$1"; shift;; *) die "unknown tunnel disconnect option: $opt";; esac; done
  state="$(tunnel_root)/$profile"; tunnel_load "$state"
  for label in backend frontend; do
    p="$(cat "$state/$label.pid" 2>/dev/null || true)"
    if tunnel_pid_owned "$p" "$state/ssh_config"; then kill "$p" 2>/dev/null || true
    elif tunnel_alive "$p"; then die "refusing to kill unrelated/reused PID $p for $label; state retained at $state"; fi
  done
  for i in {1..10}; do
    if ! tunnel_pid_owned "$(cat "$state/backend.pid")" "$state/ssh_config" && ! tunnel_pid_owned "$(cat "$state/frontend.pid")" "$state/ssh_config"; then break; fi
    sleep 1
  done
  if tunnel_pid_owned "$(cat "$state/backend.pid")" "$state/ssh_config" || tunnel_pid_owned "$(cat "$state/frontend.pid")" "$state/ssh_config"; then die "SSH tunnel process did not exit; state retained at $state"; fi
  if ! tunnel_free "$BACKEND_HOST_PORT" || ! tunnel_free "$FRONTEND_HOST_PORT"; then die "a forwarded host port remains occupied; state retained at $state"; fi
  if [[ -n "$FRONTEND_HTTPS_PORT" || -n "$BACKEND_HTTPS_PORT" ]]; then
    status="$(tailscale serve status 2>&1 || true)"
    if [[ -n "$FRONTEND_HTTPS_PORT" ]] && grep -Fq "https://$TAILSCALE_FQDN:$FRONTEND_HTTPS_PORT" <<<"$status" && grep -Fq "proxy http://127.0.0.1:$FRONTEND_HOST_PORT" <<<"$status"; then tailscale serve --https="$FRONTEND_HTTPS_PORT" off; else note 'leaving frontend Serve handler because it no longer matches this profile'; fi
    status="$(tailscale serve status 2>&1 || true)"
    if [[ -n "$BACKEND_HTTPS_PORT" ]] && grep -Fq "https://$TAILSCALE_FQDN:$BACKEND_HTTPS_PORT" <<<"$status" && grep -Fq "proxy http://127.0.0.1:$BACKEND_HOST_PORT" <<<"$status"; then tailscale serve --https="$BACKEND_HTTPS_PORT" off; else note 'leaving backend Serve handler because it no longer matches this profile'; fi
  fi
  rm -rf "$state"; note "disconnected profile '$profile'"
}

cmd="${1:-help}"; shift || true
case "$cmd" in
 help|-h|--help) usage; exit 0;;
 accounts) for a in gh-26 gh-06 gh-df gh-odo gh-do; do echo "[$a]"; (CS_BURST_ACCOUNT="$a"; export CS_BURST_ACCOUNT; ghx auth status 2>&1 | sed -n '1,6p') || true; done; exit 0;;
 tunnel) sub="${1:-help}"; shift || true; case "$sub" in help|-h|--help) tunnel_usage;; connect) tunnel_connect "$@";; expose) tunnel_expose "$@";; status) tunnel_status "$@";; disconnect) tunnel_disconnect "$@";; *) die "unknown tunnel action $sub";; esac; exit 0;;
 status) while (($#)); do case "$1" in --account) shift; set_account "${1:-}"; shift;; *) die "unknown status option $1";; esac; done; ghx codespace list --json name,repository,state,machineName,createdAt,lastUsedAt,displayName,gitStatus,owner; exit $?;;
 exec)
   codespace=''; output=''
   while (($#)); do case "$1" in --codespace|-c) codespace="${2:?missing Codespace name}"; shift 2;; --account) shift; set_account "${1:-}"; shift;; --output|-o) output="${2:?missing output path}"; shift 2;; --) shift; break;; *) die "unknown exec option '$1'";; esac; done
   [[ -n "$codespace" ]] || die 'exec requires --codespace NAME'
   (($#)) || die 'remote command is required after --'
   command -v gh >/dev/null || die 'gh CLI is required'
   ghx auth status >/dev/null 2>&1 || die 'selected gh profile is not authenticated'
   if [[ -n "$output" ]]; then
     mkdir -p "$(dirname -- "$output")"
     set +e; ghx codespace ssh -c "$codespace" -- "$@" 2>&1 | tee "$output"; rc=${PIPESTATUS[0]}; set -e
     exit "$rc"
   fi
   ghx codespace ssh -c "$codespace" -- "$@"; exit $?;;
 cp)
   codespace=''; recursive=0
   while (($#)); do case "$1" in --codespace|-c) codespace="${2:?missing Codespace name}"; shift 2;; --account) shift; set_account "${1:-}"; shift;; --recursive|-r) recursive=1; shift;; --) shift; break;; *) break;; esac; done
   [[ -n "$codespace" ]] || die 'cp requires --codespace NAME'
   (($# == 2)) || die 'cp requires SOURCE and DESTINATION; prefix the remote side with remote:'
   [[ "$1" == remote:* || "$2" == remote:* ]] || die 'one cp path must use the remote: prefix'
   command -v gh >/dev/null || die 'gh CLI is required'
   ghx auth status >/dev/null 2>&1 || die 'selected gh profile is not authenticated'
   if ((recursive)); then ghx codespace cp -r -c "$codespace" "$1" "$2"; else ghx codespace cp -c "$codespace" "$1" "$2"; fi; exit $?;;
 stop|delete)
   action="$cmd"; codespace=''
   while (($#)); do case "$1" in --codespace|-c) codespace="${2:?missing Codespace name}"; shift 2;; --account) shift; set_account "${1:-}"; shift;; *) die "unknown $action option '$1'";; esac; done
   [[ -n "$codespace" ]] || die "$action requires --codespace NAME"
   command -v gh >/dev/null || die 'gh CLI is required'
   ghx auth status >/dev/null 2>&1 || die 'selected gh profile is not authenticated'
   if [[ "$action" == stop ]]; then ghx codespace stop -c "$codespace"; else ghx codespace delete -c "$codespace" -f; fi; exit $?;;
 run) ;;
 *) die "unknown command '$cmd'";; esac
repo=''; launcher="$DEFAULT_REPO"; machine="$DEFAULT_MACHINE"; idle="$DEFAULT_IDLE"; retention="$DEFAULT_RETENTION"; workdir="$PWD"; keep=0; no_artifacts=0; dry=0; allow_sensitive=0; keep_running=0; idle_explicit=0; includes=()
while (($#)); do case "$1" in
 --repo) repo="${2:?missing repo}"; shift 2;; --launcher) launcher="${2:?missing launcher}"; shift 2;; --machine) machine="${2:?missing machine}"; shift 2;; --idle-timeout) idle="${2:?missing timeout}"; idle_explicit=1; shift 2;; --retention) retention="${2:?missing retention}"; shift 2;; --workdir) workdir="${2:?missing workdir}"; shift 2;; --include) includes+=("${2:?missing include path}"); shift 2;; --allow-sensitive-snapshot) allow_sensitive=1; shift;; --keep-running) keep_running=1; shift;; --account) shift; set_account "${1:-}"; shift;; --keep) keep=1; shift;; --no-artifacts) no_artifacts=1; shift;; --dry-run) dry=1; shift;; --) shift; break;; *) die "unknown option '$1'; put command after --";; esac; done
 ((keep == 0 || keep_running == 0)) || die '--keep and --keep-running cannot be used together'
 if ((keep_running && !idle_explicit)); then idle=4h; fi
if ((keep_running)); then printf "\nWARNING: --keep-running leaves this Codespace running with an idle timeout of %s. Codespaces also have a hard 12-hour maximum lifetime. Stop/delete it and collect required results before either limit.\n\n" "$idle"; fi
 (($#)) || die 'remote command is required after --'
[[ "$repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || die '--repo must be OWNER/REPO'
[[ "$launcher" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || die '--launcher must be OWNER/REPO'
[[ -d "$workdir" ]] || die "workdir missing: $workdir"
workdir="$(cd "$workdir" && pwd -P)"
if ((dry)); then printf 'Account=%s\nLauncher=%s\nRepo=%s\nMachine=%s\nIdle=%s\nRetention=%s\nWorkdir=%s\n' "${CS_BURST_ACCOUNT:-default}" "$launcher" "$repo" "$machine" "$idle" "$retention" "$workdir"; for path in "${includes[@]}"; do printf 'Include=%s\n' "$path"; done; printf 'Command='; printf ' %q' "$@"; echo; exit 0; fi
command -v gh >/dev/null || die 'gh CLI is required'
ghx auth status >/dev/null 2>&1 || die 'selected gh profile is not authenticated'
ghx repo view "$launcher" --json nameWithOwner >/dev/null || die "cannot access launcher $launcher"
ghx repo view "$repo" --json nameWithOwner >/dev/null || die "cannot access project repo $repo"
stamp="$(date -u +%Y%m%dT%H%M%SZ)-$RANDOM"; tmp="$(mktemp -d "$TMP_BASE/cs-burst.XXXXXX")"; out_dir="$workdir/artifacts/cs-burst-$stamp"; mkdir -p "$out_dir"; cs_name=''
finish(){ rc=$?; trap - EXIT INT TERM; set +e; if [[ -n "$cs_name" ]]; then if ((keep_running)); then note "leaving Codespace running for temporary test use: $cs_name"; elif ((keep)); then ghx codespace stop -c "$cs_name" >/dev/null 2>&1; note "keeping stopped worker (storage still bills): $cs_name"; else ghx codespace stop -c "$cs_name" >/dev/null 2>&1; ghx codespace delete -c "$cs_name" -f >/dev/null 2>&1; fi; fi; rm -rf "$tmp"; note "results: $out_dir"; exit "$rc"; }; trap finish EXIT INT TERM
archive="$tmp/worktree.tar.gz"; snapshot="$tmp/snapshot"; mkdir -p "$snapshot"
# Build the normal safe snapshot first, then overlay only explicitly selected paths.
(cd "$workdir" && tar -czf "$archive" --exclude='./.git' --exclude='./node_modules' --exclude='*/node_modules' --exclude='./.venv' --exclude='*/.venv' --exclude='./venv' --exclude='*/venv' --exclude='./.next' --exclude='*/.next' --exclude='./dist' --exclude='*/dist' --exclude='./build' --exclude='*/build' --exclude='./coverage' --exclude='*/coverage' --exclude='./.turbo' --exclude='*/.turbo' --exclude='./artifacts' --exclude='*/artifacts' --exclude='./.env' --exclude='./.env.*' --exclude='*/.env' --exclude='*/.env.*' --exclude='./.npmrc' --exclude='*/.npmrc' --exclude='./.pypirc' --exclude='*/.pypirc' --exclude='./.netrc' --exclude='*/.netrc' --exclude='./.git-credentials' --exclude='*/.git-credentials' --exclude='./.ssh' --exclude='*/.ssh' --exclude='./id_rsa' --exclude='*/id_rsa' --exclude='./id_ed25519' --exclude='*/id_ed25519' --exclude='*.pem' --exclude='*.key' --exclude='*.p12' --exclude='*.pfx' --exclude='./.aws' --exclude='*/.aws' --exclude='./.azure' --exclude='*/.azure' --exclude='./.kube' --exclude='*/.kube' --exclude='./.docker/config.json' --exclude='*/.docker/config.json' --exclude='./.devcontainer' --exclude='*/.devcontainer' --exclude='./.vscode' --exclude='*/.vscode' --exclude='./.idea' --exclude='*/.idea' .)
tar -xzf "$archive" -C "$snapshot"
: > "$out_dir/snapshot-includes.txt"
for include in "${includes[@]}"; do
  [[ -n "$include" && "$include" != /* ]] || die "include must be a non-empty relative path: $include"
  [[ ! "/$include/" =~ /\.\./ ]] || die "include path cannot contain '..': $include"
  [[ ! "/$include/" =~ /(^|/)\.git(/|$) ]] || die "including .git metadata is not supported: $include"
  source_path="$workdir/$include"
  [[ -e "$source_path" || -L "$source_path" ]] || die "included path does not exist: $include"
  resolved="$(realpath -m -- "$source_path")"
  [[ "$resolved" == "$workdir"/* ]] || die "included path resolves outside workdir: $include"
  sensitive_path=''
  while IFS= read -r -d '' candidate; do
    base="${candidate##*/}"; lower="${candidate,,}"
    if [[ "$base" == .env || "$base" == .env.* || "$base" == *.env || "$base" == *.env.* || "$base" == .npmrc || "$base" == .pypirc || "$base" == .netrc || "$base" == .git-credentials || "$base" == .ssh || "$base" == id_rsa || "$base" == id_ed25519 || "$base" =~ \.(pem|key|p12|pfx)$ || "$lower" == *credential* || "$lower" == *secret* ]]; then
      sensitive_path="$candidate"; break
    fi
  done < <(if [[ -d "$source_path" && ! -L "$source_path" ]]; then find "$source_path" -print0; else printf '%s\0' "$source_path"; fi)
  if [[ -n "$sensitive_path" ]]; then
    ((allow_sensitive)) || die "'$include' contains a sensitive path (${sensitive_path#"$workdir"/}); add --allow-sensitive-snapshot only if you intend to transfer it"
    note "WARNING: explicitly transferring sensitive path via $include to Codespaces"
  fi
  mkdir -p "$snapshot/$(dirname -- "$include")"
  cp -a -- "$source_path" "$snapshot/$(dirname -- "$include")/"
  printf '%s\n' "$include" >> "$out_dir/snapshot-includes.txt"
done
(cd "$snapshot" && tar -czf "$archive" .)
rm -rf "$snapshot"
note "creating disposable worker from $launcher"
display="burst-$stamp"; ghx codespace create --repo "$launcher" --machine "$machine" --idle-timeout "$idle" --retention-period "$retention" --display-name "$display" >/dev/null
for attempt in {1..20}; do cs_name="$(ghx api /user/codespaces --jq ".codespaces[] | select(.display_name == \"$display\") | .name")"; [[ -n "$cs_name" ]] && break; sleep 2; done; [[ -n "$cs_name" ]] || die 'Codespaces created but its name could not be resolved; check gh codespace list'
printf '%s\n' "$cs_name" > "$out_dir/codespace-name.txt"
note "waiting for worker SSH to become ready"
ghx codespace ssh -c "$cs_name" -- true >/dev/null
remote_dir="/workspaces/${repo##*/}"
script="$tmp/remote.sh"; { cat <<'REMOTE'
#!/usr/bin/env bash
set -Eeuo pipefail
REMOTE
printf 'rm -rf -- %q\nmkdir -p -- %q\ncd -- %q\n' "$remote_dir" "$remote_dir" "$remote_dir"
cat <<'REMOTE'
tar -xzf "$HOME/cs-burst-worktree.tar.gz"
REMOTE
printf 'set +e\n('
printf ' %q' "$@"
printf ' ) 2>&1 | tee command.log\nrc=${PIPESTATUS[0]}\nprintf "%%s\\n" "$rc" > exit-code.txt\ntar -czf "$HOME/cs-burst-results.tar.gz" command.log exit-code.txt\ntar -czf "$HOME/cs-burst-artifacts.tar.gz" --exclude="./.git" --exclude="./node_modules" --exclude="*/node_modules" --exclude="./.next" --exclude="*/.next" --exclude="./dist" --exclude="*/dist" --exclude="./build" --exclude="*/build" --exclude="./.turbo" --exclude="*/.turbo" --exclude="./.cache" --exclude="*/.cache" --exclude="./.vercel" --exclude="*/.vercel" --exclude="./out" --exclude="*/out" --exclude="./.venv" --exclude="*/.venv" --exclude="./venv" --exclude="*/venv" --exclude="./.env" --exclude="./.env.*" --exclude="*/.env" --exclude="*/.env.*" --exclude="./.npmrc" --exclude="*/.npmrc" --exclude="./.pypirc" --exclude="*/.pypirc" --exclude="./.netrc" --exclude="*/.netrc" --exclude="./.git-credentials" --exclude="*/.git-credentials" --exclude="./.ssh" --exclude="*/.ssh" --exclude="./id_rsa" --exclude="*/id_rsa" --exclude="./id_ed25519" --exclude="*/id_ed25519" --exclude="*.pem" --exclude="*.key" --exclude="*.p12" --exclude="*.pfx" --exclude="./.aws" --exclude="*/.aws" --exclude="./.azure" --exclude="*/.azure" --exclude="./.kube" --exclude="*/.kube" --exclude="./.docker/config.json" --exclude="*/.docker/config.json" . 2>/dev/null || true\nexit "$rc"\n'; } > "$script"
ghx codespace cp -e -c "$cs_name" "$archive" "remote:cs-burst-worktree.tar.gz"
ghx codespace cp -e -c "$cs_name" "$script" "remote:cs-burst-command.sh"
set +e; ghx codespace ssh -c "$cs_name" -- 'bash ~/cs-burst-command.sh'; rc=$?; set -e; printf '%s\n' "$rc" > "$out_dir/local-ssh-exit-code.txt"
if ((!no_artifacts)); then set +e; ghx codespace cp -e -c "$cs_name" 'remote:cs-burst-results.tar.gz' "$out_dir/remote-results.tar.gz"; a=$?; ghx codespace cp -e -c "$cs_name" 'remote:cs-burst-artifacts.tar.gz' "$out_dir/remote-artifacts.tar.gz"; b=$?; set -e; ((a!=0)) || tar -xzf "$out_dir/remote-results.tar.gz" -C "$out_dir" || true; if ((b==0)); then mkdir -p "$out_dir/project-output"; tar -xzf "$out_dir/remote-artifacts.tar.gz" -C "$out_dir/project-output" || true; fi; fi
exit "$rc"
