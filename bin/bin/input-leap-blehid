#!/usr/bin/env bash
# Switch Input Leap to the Windows host, then ask BleHid to select the iPhone.
set -euo pipefail

if command -v wtype >/dev/null; then
    # Wayland virtual keyboard (Omarchy/Hyprland).
    wtype -M ctrl -M logo -k w -m logo -m ctrl
    sleep 0.4
    wtype -M ctrl -M alt -k Caps_Lock -m alt -m ctrl
elif command -v xdotool >/dev/null; then
    # X11/XWayland fallback (Arch).
    xdotool key --clearmodifiers --delay 40 ctrl+super+w
    sleep 0.4
    xdotool key --clearmodifiers --delay 40 ctrl+alt+Caps_Lock
else
    echo "input-leap-blehid: install wtype (Wayland) or xdotool (X11)" >&2
    exit 127
fi
