#!/usr/bin/env bash
# mcp-relay CLI -- manual control for the local/remote MetaMCP switch.
# Runs on ubuntu (or over SSH from anywhere onto ubuntu). Shares state with
# mcp-relay-watcher.sh: reads/writes the same CLOUDFLARED_SERVICE line and
# the same pin file, so the two never disagree about current state.

set -euo pipefail

: "${CLOUDFLARED_ENV_FILE:?CLOUDFLARED_ENV_FILE must be set - the env file ubuntu cloudflared-mcp.service sources CLOUDFLARED_SERVICE from}"
: "${WATCHER_STATE_DIR:?WATCHER_STATE_DIR must be set (e.g. /home/ubuntu/.local/state/mcp-relay)}"
: "${LOCAL_SERVICE_URL:?LOCAL_SERVICE_URL must be set (ubuntu own MetaMCP, e.g. http://localhost:12008)}"
: "${REMOTE_SERVICE_URL:?REMOTE_SERVICE_URL must be set (archlinux MetaMCP over the private network)}"
: "${CLOUDFLARED_UNIT:=cloudflared-mcp.service}"

PIN_FILE="${WATCHER_STATE_DIR}/pin"
FAILCOUNT_FILE="${WATCHER_STATE_DIR}/failcount"

usage() {
  cat <<EOF
Usage: mcp-relay <command>

Commands:
  status       Show current service target, pin state, and failure count
  use local    Switch to ubuntu own local MetaMCP and pin it there
  use remote   Switch to archlinux MetaMCP over Tailscale and clear the pin
  pin          Pin the current target so the watcher will not switch it
  unpin        Clear the pin (watcher may fail forward again on failure)

"use local" and "use remote" both set the pin: local because failing back to
archlinux should never happen without a human choosing it here; remote
because moving back to archlinux is exactly what a human choosing this
command means.
EOF
}

get_current_service() {
  grep -E "^CLOUDFLARED_SERVICE=" "${CLOUDFLARED_ENV_FILE}" | tail -n1 | cut -d= -f2-
}

set_service() {
  local new_url="$1"
  local tmp
  tmp="$(mktemp "${CLOUDFLARED_ENV_FILE}.XXXXXX")"
  local found=0
  while IFS= read -r line; do
    if [[ "${line}" == CLOUDFLARED_SERVICE=* ]]; then
      echo "CLOUDFLARED_SERVICE=${new_url}"
      found=1
    else
      echo "${line}"
    fi
  done < "${CLOUDFLARED_ENV_FILE}" > "${tmp}"
  if [ "${found}" -eq 0 ]; then
    echo "CLOUDFLARED_SERVICE=${new_url}" >> "${tmp}"
  fi
  mv "${tmp}" "${CLOUDFLARED_ENV_FILE}"
}

reload_cloudflared() {
  local rendered="${HOME}/.cloudflared/config.yml.rendered"
  set -a
  # shellcheck disable=SC1090
  source "${CLOUDFLARED_ENV_FILE}"
  set +a
  envsubst < "${HOME}/.cloudflared/config.yml" > "${rendered}"

  if ! cloudflared tunnel --config "${rendered}" ingress validate; then
    echo "ERROR: rendered cloudflared config failed validation, not restarting" >&2
    return 1
  fi

  systemctl --user restart "${CLOUDFLARED_UNIT}"
}

label_for() {
  local url="$1"
  if [ "${url}" = "${LOCAL_SERVICE_URL}" ]; then
    echo "local (ubuntu)"
  elif [ "${url}" = "${REMOTE_SERVICE_URL}" ]; then
    echo "remote (archlinux)"
  else
    echo "unknown (${url})"
  fi
}

cmd_status() {
  local current
  current="$(get_current_service)"
  echo "current service: $(label_for "${current}") -- ${current}"
  if [ -f "${PIN_FILE}" ]; then
    echo "pin: set (watcher will not auto-switch)"
  else
    echo "pin: not set (watcher may fail forward on sustained failure)"
  fi
  if [ -f "${FAILCOUNT_FILE}" ]; then
    echo "consecutive failed health checks: $(cat "${FAILCOUNT_FILE}")"
  else
    echo "consecutive failed health checks: 0 (no checks recorded yet)"
  fi
}

cmd_use() {
  local target="$1"
  local url
  case "${target}" in
    local)
      url="${LOCAL_SERVICE_URL}"
      ;;
    remote)
      url="${REMOTE_SERVICE_URL}"
      ;;
    *)
      echo "ERROR: use requires local or remote, got: ${target}" >&2
      usage
      exit 1
      ;;
  esac

  local current
  current="$(get_current_service)"

  if [ "${current}" = "${url}" ]; then
    echo "already on $(label_for "${url}") -- no restart needed"
  else
    echo "switching to $(label_for "${url}") ..."
    set_service "${url}"

    if ! reload_cloudflared; then
      echo "ERROR: switch failed at cloudflared reload, state may be inconsistent" >&2
      exit 1
    fi
  fi

  mkdir -p "${WATCHER_STATE_DIR}"
  touch "${PIN_FILE}"
  echo "done -- pinned to $(label_for "${url}")"
}

cmd_pin() {
  mkdir -p "${WATCHER_STATE_DIR}"
  touch "${PIN_FILE}"
  echo "pinned -- watcher will not auto-switch until unpin"
}

cmd_unpin() {
  rm -f "${PIN_FILE}"
  echo "unpinned -- watcher may fail forward again on sustained failure"
}

main() {
  local cmd="${1:-}"
  case "${cmd}" in
    status)
      cmd_status
      ;;
    use)
      cmd_use "${2:-}"
      ;;
    pin)
      cmd_pin
      ;;
    unpin)
      cmd_unpin
      ;;
    -h|--help|help|"")
      usage
      ;;
    *)
      echo "ERROR: unknown command: ${cmd}" >&2
      usage
      exit 1
      ;;
  esac
}

main "$@"
