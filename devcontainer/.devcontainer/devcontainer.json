{
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20-trixie",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "postCreateCommand": "bash /workspaces/codespaces/.devcontainer/post-create.sh",
  "postStartCommand": "bash /workspaces/codespaces/.devcontainer/post-start.sh",
  "postAttachCommand": "mkdir -p /tmp/mcp; pgrep -x syncthing > /dev/null || (syncthing --no-browser > /tmp/mcp/syncthing.log 2>&1 &)"
}
