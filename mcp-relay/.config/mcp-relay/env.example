# Per-machine env for the mcp-relay registry server (ubuntu only, currently).
# Copy to ~/.config/mcp-relay/env (stow will symlink it there) and fill in
# real values — that file is gitignored/stignored, this template is not.

MCP_RELAY_DIR=/home/dyung/Projects/mcp-relay
MCP_RELAY_PORT=12010
MCP_RELAY_REGISTRY_PATH=/home/dyung/Projects/mcp-relay/registry.json
NODE_BIN=node
