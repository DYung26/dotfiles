[Unit]
Description=Maximize the EchoProfile Chromium window on its virtual display
Requires=echoprofile-login.service
After=echoprofile-login.service

[Service]
Type=oneshot
Environment=DISPLAY=:2
ExecStart=%h/.local/bin/echoprofile-maximize-window
TimeoutStartSec=200
RemainAfterExit=yes

[Install]
WantedBy=default.target
