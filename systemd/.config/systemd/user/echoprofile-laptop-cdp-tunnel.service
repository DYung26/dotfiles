[Unit]
Description=Secure SSH tunnel to laptop EchoProfile Chromium CDP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-%h/Projects/dotfiles/systemd/systemd.env
ExecStart=/usr/bin/ssh -N -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -L 127.0.0.1:${ECHOPROFILE_LAPTOP_LOCAL_PORT}:127.0.0.1:${ECHOPROFILE_LAPTOP_REMOTE_PORT} ${ECHOPROFILE_LAPTOP_SSH_USER}@${ECHOPROFILE_LAPTOP_TAILNET_IP}
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
