[Unit]
Description=Open the persistent EchoProfile Chromium session
Requires=echoprofile.service echoprofile-wm.service echoprofile-vnc.service
After=network-online.target echoprofile.service echoprofile-wm.service echoprofile-vnc.service

[Service]
Type=oneshot
EnvironmentFile=-%h/Projects/dotfiles/systemd/systemd.env
ExecStartPre=/usr/bin/curl --fail --silent --show-error --retry 60 --retry-connrefused --retry-delay 1 ${ECHOPROFILE_HEALTH_URL}
ExecStart=/usr/bin/env DISPLAY=${ECHOPROFILE_DISPLAY} WAYLAND_DISPLAY=${ECHOPROFILE_WAYLAND_DISPLAY} %h/.local/bin/echoprofile login
TimeoutStartSec=180
RemainAfterExit=yes

[Install]
WantedBy=default.target
