[Unit]
Description=Keep the persistent EchoProfile Chromium session available
Requires=echoprofile.service
After=network-online.target echoprofile.service
Wants=network-online.target
[Service]
Type=simple
EnvironmentFile=%h/.config/dotfiles/systemd/systemd.env.common
EnvironmentFile=%h/.config/dotfiles/systemd/systemd.env
ExecStart=%h/Projects/dotfiles/systemd/bin/echoprofile-login-watch
Restart=always
RestartSec=5
TimeoutStartSec=0
[Install]
WantedBy=default.target
