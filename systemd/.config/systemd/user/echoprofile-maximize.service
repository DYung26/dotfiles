[Unit]
Description=Maximize the EchoProfile Chromium window on its virtual display
Requires=echoprofile-login.service
After=echoprofile-login.service

[Service]
Type=oneshot
EnvironmentFile=%h/.config/dotfiles/systemd/systemd.env.common
EnvironmentFile=%h/.config/dotfiles/systemd/systemd.env
ExecStart=%h/Projects/dotfiles/systemd/bin/echoprofile-maximize-window
TimeoutStartSec=200
RemainAfterExit=yes
Restart=on-failure
RestartSec=15s

[Install]
WantedBy=default.target
