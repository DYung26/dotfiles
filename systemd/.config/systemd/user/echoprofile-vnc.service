[Unit]
Description=Tailnet-bound VNC for the EchoProfile browser display
Requires=echoprofile.service
After=echoprofile.service

[Service]
Type=simple
EnvironmentFile=%h/.config/dotfiles/systemd/systemd.env.common
EnvironmentFile=%h/.config/dotfiles/systemd/systemd.env
ExecStartPre=/usr/bin/env DISPLAY=${ECHOPROFILE_DISPLAY} %h/Projects/dotfiles/systemd/bin/wait-for-x-display
ExecStartPre=%h/Projects/dotfiles/systemd/bin/wait-for-tailnet-ip ${ECHOPROFILE_VNC_HOST}
ExecStart=/usr/bin/env DISPLAY=${ECHOPROFILE_DISPLAY} /usr/bin/x11vnc -no6 -noipv6 -display ${ECHOPROFILE_DISPLAY} -listen ${ECHOPROFILE_VNC_HOST} -rfbport ${ECHOPROFILE_VNC_PORT} -rfbauth ${ECHOPROFILE_VNC_PASSWORD_FILE} -forever -shared -noxdamage -modtweak -xkb
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
