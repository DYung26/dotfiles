[Unit]
Description=EchoProfile browser server
After=graphical-session.target network-online.target
Wants=network-online.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=ECHOPROFILE_NO_RELOAD=1
Environment=ECHOPROFILE_HOST=127.0.0.1
Environment=ECHOPROFILE_BIND_LOOPBACK=1
EnvironmentFile=-%h/Projects/dotfiles/systemd/systemd.env
ExecStartPre=/usr/bin/env DISPLAY=${ECHOPROFILE_DISPLAY} WAYLAND_DISPLAY=${ECHOPROFILE_WAYLAND_DISPLAY} %h/Projects/dotfiles/systemd/bin/wait-for-x-display
ExecStart=/usr/bin/env DISPLAY=${ECHOPROFILE_DISPLAY} WAYLAND_DISPLAY=${ECHOPROFILE_WAYLAND_DISPLAY} %h/.local/bin/echoprofile serve
Restart=on-failure
RestartSec=3
TimeoutStartSec=180

[Install]
WantedBy=default.target
