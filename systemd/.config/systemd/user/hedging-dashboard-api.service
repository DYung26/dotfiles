[Unit]
Description=Hedging Dashboard API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/hedging/dashboard
ExecStart=/usr/bin/python3 %h/Projects/hedging/dashboard/server.py
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=%h/.config/dotfiles/systemd/systemd.env.common
EnvironmentFile=%h/.config/dotfiles/systemd/systemd.env

[Install]
WantedBy=default.target
