[Unit]
Description=Hedging Dashboard API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/hedging/dashboard
# Use the project virtualenv so the pinned backtest-engine dependency is available.
ExecStart=%h/bin/run-hedging-dashboard-api
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=%h/.config/dotfiles/systemd/systemd.env.common
EnvironmentFile=%h/.config/dotfiles/systemd/systemd.env

[Install]
WantedBy=default.target
