[Unit]
Description=MCP Relay Registry Server
After=network-online.target
ConditionPathExists=%h/.config/mcp-relay/env
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=-%h/.config/mcp-relay/env
ExecStart=%h/bin/start-mcp-relay.sh
WorkingDirectory=%h
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
