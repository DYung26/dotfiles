[Unit]
Description=mcp-proxy bridge for mcp-shell (stdio -> streamable HTTP)
After=network-online.target

[Service]
# mcp-shell starts detached job workers that must outlive proxy/server restarts.
# The stdio child exits when the proxy closes its pipes; detached workers remain.
KillMode=process
LimitNOFILE=65536:524288
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/usr/local/sbin:%h/go/bin:%h/.cargo/bin
Environment=MCP_SHELL_SEC_CONFIG_FILE=%h/.config/mcp-shell/security.yaml
ExecStart=%h/.local/bin/mcp-proxy --port=8090 --host=0.0.0.0 --pass-environment -- %h/go/bin/mcp-shell
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
