[Unit]
Description=Maximize the MetaTrader 5 main window
Requires=mt5-terminal.service mt5-openbox.service
After=mt5-terminal.service mt5-openbox.service

[Service]
Type=oneshot
EnvironmentFile=%h/.config/dotfiles/systemd/systemd.env.common
EnvironmentFile=%h/.config/dotfiles/systemd/systemd.env
ExecStart=%h/Projects/dotfiles/systemd/bin/mt5-maximize-window
RemainAfterExit=yes
Restart=on-failure
RestartSec=15s
TimeoutStartSec=200

[Install]
WantedBy=default.target
