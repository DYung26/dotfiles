[Unit]
Description=Expose MT5 MCP endpoints to MetaMCP through Docker host gateway
Wants=mt5-terminal.service mt5-metaeditor.service
After=mt5-terminal.service mt5-metaeditor.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStartPre=/usr/bin/sh -c "for i in $(/usr/bin/seq 1 60); do if /usr/bin/nc -z 127.0.0.1 22345 || /usr/bin/nc -z 127.0.0.1 22346; then exit 0; fi; /usr/bin/sleep 1; done; exit 1"
ExecStart=/usr/bin/python3 %h/Projects/dotfiles/systemd/bin/mt5-mcp-gateway.py
Restart=always
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=default.target
