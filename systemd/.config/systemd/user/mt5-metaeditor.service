[Unit]
Description=MetaEditor for MetaTrader 5 MCP endpoint
Requires=mt5-xvfb.service mt5-openbox.service
After=mt5-xvfb.service mt5-openbox.service mt5-terminal.service

[Service]
Type=simple
Environment=WINEPREFIX=%h/.local/share/wine-test
Environment=WINEARCH=win64
Environment=MT5_DISPLAY=:1
Environment=MT5_XAUTHORITY=%h/.Xauthority-mt5
EnvironmentFile=-%h/Projects/dotfiles/systemd/systemd.env
WorkingDirectory=%h/.local/share/wine-test/drive_c/Program Files/MetaTrader 5
ExecStart=/usr/bin/env DISPLAY=${MT5_DISPLAY} XAUTHORITY=${MT5_XAUTHORITY} WINEPREFIX=${WINEPREFIX} WINEARCH=${WINEARCH} /usr/bin/wine "%h/.local/share/wine-test/drive_c/Program Files/MetaTrader 5/MetaEditor64.exe"
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
