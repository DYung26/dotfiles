[Unit]
Description=Openbox window manager for MetaTrader 5 virtual desktop
Requires=mt5-xvfb.service
After=mt5-xvfb.service

[Service]
Type=simple
Environment=DISPLAY=:1
Environment=XAUTHORITY=%h/.Xauthority-mt5
ExecStartPre=/usr/bin/sh -c 'for i in $(/usr/bin/seq 1 30); do /usr/bin/xdpyinfo -display :1 >/dev/null 2>&1 && exit 0; /usr/bin/sleep 1; done; exit 1'
ExecStart=/usr/bin/openbox --sm-disable
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
