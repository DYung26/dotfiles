[Unit]
Description=Openbox window manager for MetaTrader 5 virtual desktop
Requires=mt5-xvfb.service
After=mt5-xvfb.service

[Service]
Type=simple
Environment=MT5_DISPLAY=:1
Environment=MT5_XAUTHORITY=%h/.Xauthority-mt5
EnvironmentFile=-%h/Projects/dotfiles/systemd/systemd.env
ExecStartPre=/usr/bin/env DISPLAY=${MT5_DISPLAY} XAUTHORITY=${MT5_XAUTHORITY} %h/Projects/dotfiles/systemd/bin/wait-for-x-display
ExecStart=/usr/bin/env DISPLAY=${MT5_DISPLAY} XAUTHORITY=${MT5_XAUTHORITY} /usr/bin/openbox --sm-disable
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
