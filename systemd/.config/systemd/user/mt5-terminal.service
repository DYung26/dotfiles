[Unit]
Description=MetaTrader 5 terminal (Wine)
Requires=mt5-xvfb.service mt5-openbox.service
After=mt5-xvfb.service mt5-openbox.service network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/dotfiles/systemd/systemd.env.common
EnvironmentFile=%h/.config/dotfiles/systemd/systemd.env
WorkingDirectory=%h/.local/share/wine-test/drive_c/Program Files/MetaTrader 5
ExecStart=/usr/bin/env DISPLAY=${MT5_DISPLAY} XAUTHORITY=${MT5_XAUTHORITY} WINEPREFIX=${WINEPREFIX} WINEARCH=${WINEARCH} /usr/bin/wine "%h/.local/share/wine-test/drive_c/Program Files/MetaTrader 5/terminal64.exe"
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

[Install]
WantedBy=default.target
