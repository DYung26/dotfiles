[Unit]
Description=Tailnet-only VNC access to the MetaTrader 5 display
Requires=mt5-xvfb.service
After=mt5-xvfb.service network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/dotfiles/systemd/systemd.env.common
EnvironmentFile=%h/.config/dotfiles/systemd/systemd.env
ExecStartPre=/usr/bin/env DISPLAY=${MT5_DISPLAY} XAUTHORITY=${MT5_XAUTHORITY} %h/Projects/dotfiles/systemd/bin/wait-for-x-display
ExecStartPre=%h/Projects/dotfiles/systemd/bin/wait-for-tailnet-ip ${MT5_TAILNET_IP}
ExecStart=/usr/bin/env DISPLAY=${MT5_DISPLAY} XAUTHORITY=${MT5_XAUTHORITY} /usr/bin/x11vnc -display ${MT5_DISPLAY} -auth ${MT5_XAUTHORITY} -listen ${MT5_TAILNET_IP} -rfbport ${MT5_VNC_PORT} -no6 -noipv6 -rfbauth ${MT5_VNC_PASSWORD_FILE} -forever -shared -noxdamage -modtweak -xkb
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
