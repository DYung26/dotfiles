[Unit]
Description=Virtual X display for MetaTrader 5
After=network.target

[Service]
Type=simple
EnvironmentFile=%h/.config/dotfiles/systemd/systemd.env.common
EnvironmentFile=%h/.config/dotfiles/systemd/systemd.env
ExecStart=%h/Projects/dotfiles/systemd/bin/mt5-xvfb-start
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
