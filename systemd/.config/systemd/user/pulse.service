[Unit]
Description=Pulse local state daemon
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStartPre=/usr/bin/install -d -m 2770 %h/.local/run
ExecStart=%h/.local/lib/pulse/pulse-daemon
Environment=PULSE_SOCKET_PATH=%h/.local/run/pulse.sock
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
