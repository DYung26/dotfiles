#!/bin/sh
set -eu
DISPLAY="${MT5_DISPLAY:-:1}"
AUTH="${MT5_XAUTHORITY:-$HOME/.Xauthority-mt5}"
SCREEN="${MT5_SCREEN:-3072x1600x24}"
COOKIE="$(/usr/bin/mcookie)"
/usr/bin/xauth -f "$AUTH" remove "$DISPLAY" >/dev/null 2>&1 || true
/usr/bin/xauth -f "$AUTH" add "$DISPLAY" . "$COOKIE"
exec /usr/bin/Xvfb "$DISPLAY" -screen 0 "$SCREEN" -nolisten tcp -auth "$AUTH"
