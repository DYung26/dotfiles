#!/usr/bin/env bash
# Device-specific allowlists live in ignored .restart-dotfiles-user-services.<hostname>.conf files.
set -Eeuo pipefail
readonly REPO_ROOT="${DOTFILES_REPO:-$HOME/Projects/dotfiles}"
readonly USER_UNIT_DIR="$HOME/.config/systemd/user"
readonly DEVICE_NAME="$(cat /etc/hostname)"
readonly ALLOWLIST_FILE="${DOTFILES_RESTART_ALLOWLIST:-$REPO_ROOT/.restart-dotfiles-user-services.$DEVICE_NAME.conf}"
log() { printf '[restart-dotfiles-services] %s\n' "$*"; }
for command in realpath systemctl; do
  command -v "$command" >/dev/null 2>&1 || { log "ERROR: required command not found: $command"; exit 1; }
done
[[ -f "$ALLOWLIST_FILE" ]] || { log "ERROR: device allowlist not found: $ALLOWLIST_FILE"; exit 1; }
repo_real="$(realpath -e -- "$REPO_ROOT")"
ALLOWED_UNITS=()
while IFS= read -r unit; do
  [[ -z "$unit" || "$unit" == \#* ]] && continue
  ALLOWED_UNITS+=("$unit")
done < "$ALLOWLIST_FILE"
declare -A initially_active=()
restarted=0 skipped=0 failed=0
for unit in "${ALLOWED_UNITS[@]}"; do
  [[ "$unit" == *.service ]] || { log "ERROR: invalid unit entry: $unit"; exit 1; }
  if systemctl --user is-active --quiet "$unit" 2>/dev/null; then initially_active["$unit"]=1; fi
done
for unit in "${ALLOWED_UNITS[@]}"; do
  unit_path="$USER_UNIT_DIR/$unit"
  if [[ ! -L "$unit_path" ]]; then log "SKIP $unit: unit path is not a symlink"; ((skipped += 1)); continue; fi
  target_real="$(realpath -e -- "$unit_path" 2>/dev/null || true)"
  if [[ -z "$target_real" || "$target_real" != "$repo_real/"* ]]; then log "SKIP $unit: symlink does not resolve inside $repo_real"; ((skipped += 1)); continue; fi
  if [[ -z "${initially_active[$unit]:-}" ]]; then log "SKIP $unit: not active when maintenance started"; ((skipped += 1)); continue; fi
  if [[ "${DRY_RUN:-0}" == "1" ]]; then log "WOULD RESTART $unit (source: $target_real)"; ((restarted += 1)); continue; fi
  log "Restarting $unit (source: $target_real)"
  if systemctl --user restart "$unit" && systemctl --user is-active --quiet "$unit"; then log "OK $unit"; ((restarted += 1)); else log "ERROR restarting $unit"; ((failed += 1)); fi
done
log "Finished: restarted=$restarted skipped=$skipped failed=$failed"
(( failed == 0 ))
