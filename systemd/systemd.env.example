# Copy to systemd.env on each Linux device and set only that machine's values.
# systemd.env is Git-ignored, Syncthing-ignored and Stow-ignored.
# Keep credentials in their existing dedicated secret files.

# EchoProfile
ECHOPROFILE_DISPLAY=:0
ECHOPROFILE_CHANNEL=
ECHOPROFILE_WAYLAND_DISPLAY=
ECHOPROFILE_HOST=127.0.0.1
ECHOPROFILE_BIND_LOOPBACK=1
ECHOPROFILE_NO_RELOAD=1
ECHOPROFILE_AUTO_FALLBACK=
ECHOPROFILE_PORT=8756
ECHOPROFILE_HEALTH_URL=
ECHOPROFILE_SWITCHBOARD_DIR=
ECHOPROFILE_BROWSER_EXTENSION_DIR=
ECHOPROFILE_MULTICA_DIR=
ECHOPROFILE_EXTRA_EXTENSION_DIRS=
ECHOPROFILE_CDP_PORT=9222
ECHOPROFILE_VNC_HOST=
ECHOPROFILE_VNC_PORT=5901
ECHOPROFILE_VNC_PASSWORD_FILE=
ECHOPROFILE_LAPTOP_SSH_USER=
ECHOPROFILE_LAPTOP_TAILNET_IP=
ECHOPROFILE_LAPTOP_LOCAL_PORT=9224
ECHOPROFILE_LAPTOP_REMOTE_PORT=9222

# Playwright MCP
PLAYWRIGHT_MCP_NODE_BIN=
PLAYWRIGHT_MCP_CLI=
PLAYWRIGHT_MCP_CDP_ENDPOINT=
PLAYWRIGHT_MCP_PORT=8931
PLAYWRIGHT_MCP_HOST=127.0.0.1
PLAYWRIGHT_MCP_ALLOWED_HOSTS=localhost
PLAYWRIGHT_MCP_LAPTOP_CDP_ENDPOINT=
PLAYWRIGHT_MCP_LAPTOP_PORT=8932
PLAYWRIGHT_MCP_LAPTOP_HOST=127.0.0.1
PLAYWRIGHT_MCP_LAPTOP_ALLOWED_HOSTS=localhost

# MetaTrader 5
MT5_DISPLAY=:1
MT5_XAUTHORITY=
MT5_SCREEN=3072x1600x24
MT5_TAILNET_IP=
MT5_VNC_PORT=5900
MT5_VNC_EXTENDED_PORT=5903
MT5_VNC_PASSWORD_FILE=
MT5_VNC_EXTENDED_SCALE=1280x720
MT5_MCP_GATEWAY_HOST=172.20.0.1
MT5_MCP_GATEWAY_PORT_1=22345
MT5_MCP_GATEWAY_PORT_2=22346
MT5_MCP_TARGET_PORT_1=22345
MT5_MCP_TARGET_PORT_2=22346
WINEPREFIX=
WINEARCH=win64

# TigerVNC display for EchoProfile
WINDOWS_VNC_PORT=5902
WINDOWS_VNC_GEOMETRY=1536x864
WINDOWS_VNC_DEPTH=24
WINDOWS_VNC_PASSWORD_FILE=

# Market Engine
MARKET_ENGINE_DASHBOARD_HOST=127.0.0.1
MARKET_ENGINE_DASHBOARD_PORT=4177

# Workspace MCP (normally VPS only)
WORKSPACE_MCP_HOST=0.0.0.0
WORKSPACE_MCP_PORT=8003
GOOGLE_MCP_CREDENTIALS_DIR=/home/nextjs/.google_workspace_mcp/credentials
WORKSPACE_EXTERNAL_URL=
OAUTH_ALLOWED_ORIGINS=
GOOGLE_OAUTH_REDIRECT_URI=
